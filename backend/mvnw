#!/bin/sh
# ----------------------------------------------------------------------------
# Apache Maven Wrapper startup script (only-script distribution).
# Requires a JDK on PATH or JAVA_HOME set. Downloads Maven on first use.
# ----------------------------------------------------------------------------
set -e

MAVEN_WRAPPER_DIST_VERSION="3.9.9"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
WRAPPER_DIR="$SCRIPT_DIR/.mvn/wrapper"
MAVEN_HOME_LOCAL="$WRAPPER_DIR/apache-maven-$MAVEN_WRAPPER_DIST_VERSION"
DIST_URL="https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/$MAVEN_WRAPPER_DIST_VERSION/apache-maven-$MAVEN_WRAPPER_DIST_VERSION-bin.zip"

if [ ! -x "$MAVEN_HOME_LOCAL/bin/mvn" ]; then
  echo "Downloading Apache Maven $MAVEN_WRAPPER_DIST_VERSION ..."
  mkdir -p "$WRAPPER_DIR"
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL -o "$WRAPPER_DIR/maven.zip" "$DIST_URL"
  else
    wget -q -O "$WRAPPER_DIR/maven.zip" "$DIST_URL"
  fi
  unzip -q "$WRAPPER_DIR/maven.zip" -d "$WRAPPER_DIR"
  rm -f "$WRAPPER_DIR/maven.zip"
fi

exec "$MAVEN_HOME_LOCAL/bin/mvn" "$@"
