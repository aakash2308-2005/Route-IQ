# Copy this file to .env and fill in values. NEVER commit the real .env (see .gitignore).

# --- Database ---
DB_NAME=smartcommute
DB_USERNAME=smartcommute
DB_PASSWORD=change-me-locally

# --- Security ---
# JWT signing secret. MUST be at least 32 characters. Generate a random one, e.g.:
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRY_SECONDS=3600

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Optional ML ETA service (stretch; leave false for Core) ---
ETA_ML_ENABLED=false
ETA_ML_BASE_URL=http://ml-service:8000
